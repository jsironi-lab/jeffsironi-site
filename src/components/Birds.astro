---
// A loose flock of birds for the hero sky, a nod to Starling.
const points = [
  [40, 180], [62, 170], [80, 176], [95, 160], [112, 168], [128, 150], [140, 162], [155, 140], [170, 152],
  [182, 132], [198, 142], [210, 120], [226, 134], [240, 112], [252, 126], [268, 104], [282, 118], [296, 98],
  [310, 112], [322, 92], [338, 104], [350, 88], [366, 100], [380, 84], [394, 96], [408, 82], [420, 94],
  [436, 80], [450, 92], [466, 84], [480, 96], [494, 88], [508, 102], [520, 96], [534, 112], [548, 108],
  [560, 124], [150, 172], [205, 156], [260, 142], [315, 128], [372, 118], [430, 110], [488, 116], [545, 132],
  [120, 192], [300, 78], [400, 64], [470, 68], [345, 70], [232, 96],
];
const d = points.map(([x, y]) => `M${x} ${y} l5 3 l5 -3`).join(' ');
---

<svg class="birds" viewBox="0 0 600 260" aria-hidden="true">
  <path d={d} fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
