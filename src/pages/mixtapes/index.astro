---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hills from '../../components/Hills.astro';

const colors = {
  orange: 'var(--orange)',
  yellow: 'var(--yellow)',
  green: 'var(--green)',
  blue: 'var(--blue)',
  sky: 'var(--sky)',
};

const entries = (await getCollection('mixtapes')).sort((a, b) => a.data.number - b.data.number);
const tapes = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const code = `JMT-${String(entry.data.number).padStart(3, '0')}`;
    const embed = entry.data.spotify.replace('open.spotify.com/', 'open.spotify.com/embed/').split('?')[0];
    return { ...entry.data, Content, code, id: code.toLowerCase(), embed, color: colors[entry.data.color] };
  }),
);
const latestId = tapes.at(-1)?.id;
---

<Base top="dusk" title="Mixtapes · Jeff Sironi" description="Mixtapes from Jeff Sironi: playlists made for people, moods and moments.">
  <Fragment slot="hero">
    <section class="mix-hero wrap">
      <div class="mix-hero-text">
        <p class="kicker">Projects · Mixtapes</p>
        <h1 class="mix-title">Mixtapes.</h1>
        <p class="mix-lede">
          Playlists made for people, moods and moments. My favorite part is playing someone a song they’ve never heard
          and watching them love it.
        </p>
        <p class="mix-sub">New tapes whenever the mood strikes. Each one is numbered, because that’s how mixtapes work.</p>
      </div>
      <div class="tape-wrap">
        <button type="button" class="tape" aria-label="Flip the tape to side 2" data-tape-flip>
          <img class="tape-front" src="/images/tape-side-1.png" width="1800" height="1152"
            alt="Hand-drawn cassette labeled Jeff Jamz presents Mind the Groove, a mixtape, side 1" />
          <img class="tape-back" src="/images/tape-side-2.png" width="1800" height="1152" alt="" />
        </button>
      </div>
    </section>
    <Hills />
  </Fragment>

  <section class="shelf wrap" aria-labelledby="shelf-title">
    <div class="shelf-head">
      <h2 class="section-title" id="shelf-title">The tape rack</h2>
      <p>Pull out a tape to see what’s on it.</p>
    </div>
    <div class="rack">
      <div class="rack-shelves">
        {tapes.map((tape) => (
          <button
            type="button"
            class="cassette"
            data-tape={tape.id}
            aria-controls="now-playing"
            aria-pressed={tape.id === latestId ? 'true' : 'false'}
            aria-label={`${tape.code}: ${tape.title}`}
            title={`${tape.title}: ${tape.blurb}`}
            style={`--tape: ${tape.color}`}
          >
            <span class="cassette-num">{String(tape.number).padStart(3, '0')}</span>
            <span class="cassette-label"><span class="cassette-title">{tape.title}</span></span>
            <span class="cassette-foot" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="detail wrap" id="now-playing" aria-live="polite">
    {tapes.map((tape) => (
      <div class="detail-panel" data-panel={tape.id} id={tape.id} hidden={tape.id !== latestId}>
        <div class="detail-main">
          <p class="detail-kicker">
            {tape.id === latestId ? 'Latest tape' : 'From the rack'} · {tape.code} · {tape.tracks.length} tracks
          </p>
          <h2 class="section-title">{tape.title}</h2>
          <div class="detail-note"><tape.Content /></div>
          <iframe
            class="player"
            title={`Spotify player: ${tape.title}`}
            src={tape.embed}
            height="352"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          ></iframe>
          <div class="detail-actions">
            <a class="btn btn-ink" href={tape.spotify}>Listen on Spotify</a>
            {tape.appleMusic
              ? <a class="btn btn-white" href={tape.appleMusic}>Listen on Apple Music</a>
              : <span class="btn btn-soon">Apple Music: soon</span>}
          </div>
        </div>
        <ol class="tracklist">
          {tape.tracks.map((track, i) => (
            <li>
              <span class="track-n">{String(i + 1).padStart(2, '0')}</span>
              <span>{track.title} <span class="track-artist">· {track.artist}</span></span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

</Base>

<style>
  .mix-hero {
    position: relative;
    z-index: 1;
    padding-top: 40px;
    padding-bottom: clamp(160px, 17vw, 230px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: center;
  }
  .mix-hero-text { flex: 1 1 440px; }
  .mix-hero .kicker { color: var(--glow); }
  .mix-title { font-weight: 700; font-size: clamp(48px, 7vw, 84px); line-height: 1; letter-spacing: -0.02em; }
  .mix-lede { margin: 28px 0 0; max-width: 44ch; color: #DCE6F7; }
  .mix-sub { margin: 14px 0 0; max-width: 44ch; color: var(--on-navy-muted); font-size: 16px; }

  .tape-wrap { flex: 1 1 340px; max-width: 460px; display: flex; flex-direction: column; align-items: center; }
  .tape {
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform: rotate(-4deg);
  }
  /* The drawing is black ink on a clear background; flipping it to light lines reads like chalk on the night sky. */
  .tape img { width: 100%; height: auto; filter: invert(1) drop-shadow(0 0 18px rgba(229, 154, 107, 0.25)); opacity: 0.92; }
  .tape-back { position: absolute; inset: 0; visibility: hidden; transform: rotate(9deg) translate(2%, 1%); }
  .tape:hover .tape-back, .tape.is-flipped .tape-back { visibility: visible; }
  .tape:hover .tape-front, .tape.is-flipped .tape-front { visibility: hidden; }

  .shelf { padding-top: 72px; padding-bottom: 20px; }
  .shelf-head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .shelf-head p { margin: 0; color: var(--ink-muted); }
  /* Tapes stand upright with their spines out in a pale tile. The shelves wrap, so the rack grows
     a new shelf every dozen or so tapes; each row's wooden ledge is drawn by the background. */
  .rack {
    --spine-w: 60px;
    --spine-h: 280px;
    --lift: 22px;
    --ledge: 10px;
    --row: calc(var(--lift) + var(--spine-h) + var(--ledge));
    padding: 24px 30px 30px;
    background: var(--tile);
    border-radius: 22px;
  }
  .rack-shelves {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--spine-w));
    grid-auto-rows: var(--row);
    column-gap: 8px;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 calc(var(--row) - var(--ledge)),
      #C98B5E calc(var(--row) - var(--ledge)) var(--row)
    );
    border-radius: 0 0 6px 6px;
  }
  .cassette {
    align-self: end;
    margin-bottom: var(--ledge);
    width: var(--spine-w);
    height: var(--spine-h);
    display: flex;
    flex-direction: column;
    padding: 0;
    font: inherit;
    color: var(--ink);
    background: #FFFFFF;
    border: 2px solid var(--ink);
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cassette:hover { transform: translateY(-8px); }
  .cassette[aria-pressed='true'] { transform: translateY(calc(var(--lift) * -1)); box-shadow: 0 12px 20px rgba(30, 42, 68, 0.18); }
  .cassette:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .cassette-num {
    flex: 0 0 44px;
    display: grid;
    place-items: center;
    background: var(--tape);
    border-bottom: 2px solid var(--ink);
    font-weight: 700;
    font-size: 15px;
  }
  .cassette-label {
    flex: 1;
    min-height: 0;
    display: flex;
    justify-content: center;
    padding: 10px 0;
    overflow: hidden;
    background: repeating-linear-gradient(90deg, transparent 0 19px, rgba(47, 109, 184, 0.12) 19px 20px);
  }
  .cassette-title {
    writing-mode: vertical-rl;
    text-orientation: sideways;
    font-family: var(--font-hand);
    font-size: 19px;
    line-height: 1.1;
    max-width: 100%;
  }
  .cassette-foot { flex: 0 0 14px; background: var(--tape); border-top: 2px solid var(--ink); }

  .detail { padding-top: 20px; padding-bottom: 96px; scroll-margin-top: 16px; }
  .detail-panel {
    background: var(--tile);
    border-radius: 22px;
    padding: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 36px 56px;
  }
  .detail-panel[hidden] { display: none; }
  .detail-main { flex: 1 1 380px; min-width: 0; }
  .detail-kicker {
    margin: 0 0 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 13px;
    color: var(--warm);
  }
  .detail-main h2 { margin-bottom: 14px; }
  .detail-note { color: var(--ink-soft); max-width: 46ch; margin-bottom: 24px; }
  .detail-note :global(p) { margin: 0 0 12px; }
  .player { display: block; width: 100%; border: 0; border-radius: 12px; }
  .detail-actions { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 12px; }
  .tracklist { flex: 1 1 400px; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .tracklist li { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .track-n { flex: 0 0 28px; color: var(--warm); font-weight: 600; }
  .track-artist { color: var(--ink-muted); }

  @media (max-width: 640px) {
    .mix-hero { padding-top: 8px; padding-bottom: 170px; gap: 32px; }
    .tape-wrap { flex-basis: auto; max-width: 340px; margin: 0 auto; }
    .shelf { padding-top: 48px; }
    .rack { --spine-w: 42px; --spine-h: 196px; --lift: 14px; --ledge: 8px; padding: 16px 16px 20px; }
    .rack-shelves { column-gap: 5px; }
    .cassette:hover { transform: none; }
    .cassette[aria-pressed='true'] { transform: translateY(calc(var(--lift) * -1)); }
    .cassette-num { flex-basis: 30px; font-size: 12px; }
    .cassette-label { padding: 6px 0; }
    .cassette-title { font-size: 15px; }
    .cassette-foot { flex-basis: 10px; }
    .detail { padding-bottom: 64px; }
    .detail-panel { padding: 28px 22px; }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>('[data-tape]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  const detail = document.getElementById('now-playing');

  function select(id: string, opts: { scroll?: boolean } = {}) {
    if (!document.querySelector(`[data-panel="${id}"]`)) return;
    cards.forEach((card) => card.setAttribute('aria-pressed', String(card.dataset.tape === id)));
    panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
    history.replaceState(null, '', `#${id}`);
    if (opts.scroll && detail && detail.getBoundingClientRect().top > window.innerHeight * 0.6) {
      detail.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  cards.forEach((card) => card.addEventListener('click', () => select(card.dataset.tape!, { scroll: true })));

  const fromHash = location.hash.slice(1);
  if (fromHash) select(fromHash);

  // Hover flips the tape with CSS; a tap or click flips it on touch screens and for keyboard users.
  const tape = document.querySelector<HTMLButtonElement>('[data-tape-flip]');
  tape?.addEventListener('click', () => {
    const flipped = tape.classList.toggle('is-flipped');
    tape.setAttribute('aria-label', flipped ? 'Flip the tape to side 1' : 'Flip the tape to side 2');
  });
</script>
