---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hills from '../components/Hills.astro';
import { site, mailto } from '../site';

const latestTapes = (await getCollection('mixtapes')).sort((a, b) => b.data.number - a.data.number).slice(0, 3);

const questions = [
  'How do we make sure AI benefits all of humanity, not just the billionaires?',
  'How can analog media flourish in a hyper-digital age?',
  'Can we redefine “success” as happiness and helping others, not titles or money?',
];

const bookingHref = site.bookingUrl || mailto('Let’s find a time to chat');
---

<Base top="dusk">
  <Fragment slot="hero">
    <section class="hero wrap">
      <div class="hero-text">
        <h1 class="hero-title">Hi, I’m Jeff.</h1>
        <p>Welcome to my corner of the internet. I like helping people, tinkering with things, trivia, and pizza.</p>
        <p>I use this space to experiment, collect projects I’m working on, and gather things that interest me.</p>
        <a href="#work" class="hero-link">Here about work? Head this way →</a>
      </div>
      <img class="hero-photo" src="/images/jeff-cutout.png" alt="Jeff Sironi smiling, arms crossed, in a gray plaid shirt" width="397" height="400" />
    </section>
    <Hills />
  </Fragment>

  <div class="bento wrap" id="projects">
    <section class="tile tile-ohio">
      <svg class="tile-art" viewBox="0 0 160 110" aria-hidden="true">
        <path d="M6 96 L44 96 L54 70 L92 70 L102 88 L154 88" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M6 104 L154 104" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
        <path d="M120 58 C120 40 96 40 96 58 C96 70 108 80 108 80 C108 80 120 70 120 58 Z" fill="var(--orange)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
        <circle cx="108" cy="57" r="5" fill="#FFFFFF" stroke="var(--ink)" stroke-width="2.5" />
        <circle cx="40" cy="30" r="12" fill="var(--yellow)" stroke="var(--ink)" stroke-width="3" />
      </svg>
      <div>
        <h2 class="label">Home base</h2>
        <p>
          I live in central Ohio with my family. I grew up outside Boston and landed in Ohio after stops in
          Washington, DC, and Los Angeles.
        </p>
      </div>
    </section>

    <section class="tile tile-center tile-pizza">
      <img class="pizza-art" src="/images/pizza-mark.png" alt="" width="238" height="200" />
      <p>I love pizza.</p>
    </section>

    <section class="tile tile-tapes">
      <img class="tape-art" src="/images/tape-side-1.png" alt="" width="1800" height="1152" loading="lazy" />
      <h2 class="label">Mixtapes</h2>
      <p>
        I make playlists for people, moods, and moments. My favorite part is playing someone a song they’ve never
        heard and watching them love it.
      </p>
      <ul class="arrow-list tile-list">
        {latestTapes.map((tape) => (
          <li><a href={`/mixtapes#jmt-${String(tape.data.number).padStart(3, '0')}`}>{tape.data.title}</a></li>
        ))}
      </ul>
      <a class="text-link tile-foot" href="/mixtapes">See the whole rack</a>
    </section>

    <section class="tile tile-story">
      <div>
        <h2 class="label">The why</h2>
        <p>I enjoy helping people do cool things, big and small.</p>
        <p>
          Throughout my life, I’ve benefited from a handful of amazing people who believed in me more than I believed
          in myself. They’re a big reason I care so much about helping other people now.
        </p>
        <p>These days I’m fortunate to pick the projects I work on, and I want them to have meaning and impact.</p>
      </div>
      <img class="sketch-art" src="/images/jeff-sketch.png" alt="" width="900" height="1117" loading="lazy" />
    </section>

    <section class="tile tile-center tile-trivia">
      <svg class="icon-art" viewBox="0 0 80 80" aria-hidden="true">
        <path d="M12 14 H68 A6 6 0 0 1 74 20 V50 A6 6 0 0 1 68 56 H34 L20 68 V56 H12 A6 6 0 0 1 6 50 V20 A6 6 0 0 1 12 14 Z" fill="var(--yellow)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
        <path d="M32 28 C32 18 48 18 48 28 C48 35 40 35 40 42" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round" />
        <circle cx="40" cy="49" r="2.4" fill="var(--ink)" />
      </svg>
      <p>I’m pretty good at Jeopardy! I know a little about a lot.</p>
    </section>

    <section class="tile tile-center tile-code">
      <svg class="icon-art" viewBox="0 0 80 80" aria-hidden="true">
        <rect x="6" y="12" width="68" height="54" rx="7" fill="var(--green)" stroke="var(--ink)" stroke-width="3" />
        <path d="M6 26 H74" stroke="var(--ink)" stroke-width="3" />
        <path d="M30 38 L22 46 L30 54 M50 38 L58 46 L50 54 M44 36 L36 56" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <p>
        I like building things, including AI tools and experiments. Most recently, I made
        <a class="text-link" href="https://stephensironi.com">my dad’s painting portfolio</a>.
      </p>
    </section>

    <section class="tile tile-explore">
      <h2 class="label">Questions I’m chewing on</h2>
      <ul class="questions">
        {questions.map((question) => <li>{question}</li>)}
      </ul>
    </section>

    <section class="tile tile-work" id="work">
      <div class="work-main">
        <h2 class="work-title">Need some help?</h2>
        <p>
          I’ve helped build the teams, programs, and systems that make new things work, especially where people,
          learning, and technology meet. If you’re working on something meaningful, I’d love to hear about it.
        </p>
        <p class="work-open">Open to full-time roles, fractional and project work, advising, board service, and a good conversation.</p>
      </div>
      <div class="work-actions" id="contact">
        <a class="btn btn-ink" href={bookingHref}>Book a 30-minute chat →</a>
        <a class="btn btn-white" href={site.linkedin}>My background on LinkedIn</a>
        <a class="text-link" href={mailto('Hi Jeff')}>{site.email}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    z-index: 1;
    padding-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .hero-text { flex: 1 1 360px; padding-bottom: clamp(150px, 16vw, 220px); }
  .hero-text p { margin: 16px 0 0; max-width: 44ch; color: #DCE6F7; }
  .hero-text .hero-title + p { margin-top: 28px; }
  .hero-title {
    font-weight: 700;
    font-size: clamp(48px, 7vw, 84px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hero-link {
    display: inline-block;
    margin-top: 28px;
    color: var(--on-navy);
    font-weight: 600;
    text-decoration-color: var(--glow);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .hero-link:hover { color: #FFFFFF; }
  .hero-photo { flex: 0 0 auto; width: min(460px, 42vw); height: auto; margin-bottom: clamp(10px, 2.5vw, 30px); }

  .bento {
    padding-top: 72px;
    padding-bottom: 96px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    grid-template-areas:
      'ohio ohio pizza'
      'tapes story story'
      'tapes trivia code'
      'explore explore explore'
      'work work work';
  }
  .tile {
    background: var(--tile);
    border-radius: 22px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tile p { margin: 0; }
  .tile-center { align-items: center; text-align: center; }
  .label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm);
  }
  .text-link {
    color: var(--ink);
    font-weight: 600;
    text-decoration-color: var(--glow);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .text-link:hover { color: var(--warm); }

  .tile-ohio { grid-area: ohio; flex-direction: row; align-items: center; gap: 28px; }
  .tile-ohio .label { margin-bottom: 6px; }
  .tile-art { flex: 0 0 160px; width: 160px; height: auto; }
  .tile-pizza { grid-area: pizza; justify-content: center; }
  .pizza-art { width: 104px; height: auto; }

  .tile-tapes { grid-area: tapes; }
  .tape-art { width: 100%; height: auto; transform: rotate(-4deg); margin: 4px 0 8px; }
  .tile-list { margin-top: 6px; font-weight: 600; }
  .tile-list a { color: var(--ink); text-decoration: none; }
  .tile-list a:hover { color: var(--warm); text-decoration: underline; }
  .tile-foot { margin-top: auto; }

  .tile-story { grid-area: story; flex-direction: row; align-items: center; gap: 28px; }
  .tile-story .label { margin-bottom: 6px; }
  .tile-story p + p { margin-top: 12px; }
  .sketch-art { flex: 0 0 150px; width: 150px; height: auto; }

  .tile-trivia { grid-area: trivia; }
  .tile-code { grid-area: code; }
  .icon-art { width: 72px; height: 72px; }

  .tile-explore { grid-area: explore; }
  .questions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px 40px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.35;
  }
  .questions li { display: flex; gap: 10px; }
  .questions li::before { content: '→'; content: '→' / ''; color: var(--warm); }

  .tile-work {
    grid-area: work;
    background: var(--tile-strong);
    flex-direction: row;
    flex-wrap: wrap;
    gap: 28px 56px;
    padding: 40px;
  }
  .work-main { flex: 1 1 460px; }
  .work-title { font-weight: 700; font-size: 40px; line-height: 1.05; letter-spacing: -0.01em; margin-bottom: 12px; }
  .work-main p { max-width: 54ch; }
  .work-main .work-open { margin-top: 18px; font-size: 16px; color: var(--ink-soft); }
  .work-actions { flex: 0 1 280px; display: flex; flex-direction: column; gap: 12px; justify-content: center; text-align: center; }

  @media (max-width: 760px) {
    .hero { padding-top: 0; flex-direction: column; align-items: stretch; gap: 0; }
    .hero-photo {
      order: -1;
      align-self: flex-end;
      width: min(330px, 86%);
      /* Bleeds off the right edge on purpose; the hero clips it. */
      margin: 0 -72px -84px 0;
      -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 92%);
      mask-image: linear-gradient(to bottom, #000 62%, transparent 92%);
    }
    .hero-text { position: relative; flex-basis: auto; padding-bottom: 170px; }
    .hero-title { font-size: 56px; text-shadow: 0 2px 18px rgba(18, 28, 58, 0.6); }
    .bento {
      padding-top: 48px;
      padding-bottom: 64px;
      grid-template-columns: 1fr;
      grid-template-areas: 'ohio' 'pizza' 'story' 'tapes' 'trivia' 'code' 'explore' 'work';
    }
    .tile { padding: 24px; }
    .tile-ohio { flex-direction: column; align-items: center; text-align: center; }
    .tile-art { flex-basis: auto; width: 140px; }
    .tile-story { flex-direction: column; align-items: flex-start; }
    .sketch-art { order: -1; align-self: center; width: 110px; flex-basis: auto; }
    .tile-work { padding: 28px 24px; }
    .work-title { font-size: 32px; }
    .work-actions { flex-basis: 100%; }
  }
</style>
