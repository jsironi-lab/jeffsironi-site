---
import NavBar from '../components/NavBar.astro';
import { site, mailto } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.name,
  description = 'Jeff Sironi’s corner of the internet: helping people do cool things, mixtapes, and things that interest me.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/images/jeff-profile.jpg', Astro.site)} />
  <meta name="theme-color" content="#A8D5F7" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Instrument+Sans:wght@400;600&family=Permanent+Marker&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="sky">
    <NavBar />
    <slot name="hero" />
  </div>

  <main>
    <slot />
  </main>

  <div class="horizon" aria-hidden="true">
    <img class="peek" src="/images/jeff-sketch.png" alt="" width="900" height="1117" loading="lazy" />
    <svg viewBox="0 0 1440 200" preserveAspectRatio="none">
      <path d="M0 140 L1000 140 L1030 104 L1250 104 L1280 124 L1440 124 L1440 200 L0 200 Z" fill="#AFC9EC" />
      <path d="M0 130 L700 130 L730 100 L900 100 L930 130 L1150 130 L1180 116 L1300 116 L1330 130 L1440 130 L1440 200 L0 200 Z" fill="var(--orange)" />
      <path d="M0 160 L520 160 L550 142 L640 142 L670 160 L1440 160 L1440 200 L0 200 Z" fill="var(--green)" />
      <path d="M0 182 L1440 182 L1440 200 L0 200 Z" fill="var(--navy-deep)" />
    </svg>
  </div>

  <footer class="site-footer">
    <div class="wrap footer-main">
      <div class="footer-about">
        <a href="/" class="site-name">
          {site.name}
          <img class="pizza" src="/images/pizza-mark-cream.png" alt="" width="238" height="200" />
        </a>
        <p>My little corner of the internet.<br />{site.location}</p>
      </div>
      <nav class="footer-col" aria-label="Projects">
        <p class="footer-label">Projects</p>
        <ul class="arrow-list">
          <li><a href="/mixtapes">Mixtapes</a></li>
          <li><span>From the woodshop <em>(soon)</em></span></li>
          <li><span>Photography <em>(soon)</em></span></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-label="Get in touch">
        <p class="footer-label">Say hi</p>
        <ul class="arrow-list">
          <li><a href={mailto('Hi Jeff')}>Email</a></li>
          <li><a href={site.linkedin}>LinkedIn</a></li>
          <li><a href={site.bookingUrl || '/#work'}>Book a meeting</a></li>
        </ul>
      </nav>
    </div>
    <div class="wrap footer-base">© {new Date().getFullYear()} {site.name}</div>
  </footer>
</body>
</html>
